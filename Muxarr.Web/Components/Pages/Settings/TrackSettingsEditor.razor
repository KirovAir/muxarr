@using Muxarr.Web.Helpers
<div>
    @* --- Track Removal --- *@
    <div class="mb-3 form-check form-switch">
        <InputCheckbox id="@($"strip{TrackTypeLabel}Tracks")" class="form-check-input" @bind-Value="Settings.Enabled"
                       @bind-Value:after="OnEnabledToggled"/>
        <label class="form-check-label" for="@($"strip{TrackTypeLabel}Tracks")">Remove
            unwanted @TrackTypeLabel.ToLower() tracks</label>
    </div>

    @if (Settings.Enabled)
    {
        <div class="ms-3 ps-3 border-start mb-3">
            <div class="mb-3">
                <label class="form-label mb-1">Languages to keep</label>
                <LanguagePriorityEditor Languages="Settings.AllowedLanguages" TrackType="TrackType" Settings="Settings"
                                        OnChange="StateHasChanged"/>
                <small class="form-text text-muted">@(IsAudio ? "Only audio in these languages is kept." : "Only subtitles in these languages are kept.") Click a language to change its settings. Drag to reorder.</small>
            </div>

            <div class="mb-2">
                <a class="text-decoration-none small" role="button" @onclick="() => _moreOpen = !_moreOpen">
                    <i class="bi @(_moreOpen ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>More @(TrackTypeLabel.ToLower()) options
                </a>
                @if (!_moreOpen && MoreSummary is { Length: > 0 } summary)
                {
                    <span class="small text-muted ms-2">@summary</span>
                }
            </div>

            @if (_moreOpen)
            {
                <div class="ms-2 ps-3 border-start mb-3">
                    <div class="mb-3">
                        <label class="form-label mb-0">@(IsAudio ? "Audio track types" : "Subtitle types")</label>
                        <small class="form-text text-muted d-block mb-2">@PolicyText.Summary(Settings, TrackType)</small>
                        <div class="row g-2" style="max-width: 720px;">
                            @if (!IsAudio)
                            {
                                <div class="col-12">
                                    <div class="option-label text-muted small mb-1">Full and forced subtitles</div>
                                    <select class="form-select form-select-sm" value="@Settings.Coverage"
                                            @onchange="e => Settings.Coverage = Enum.Parse<SubtitleCoverage>(e.Value?.ToString() ?? nameof(SubtitleCoverage.Both))">
                                        @foreach (var coverage in Enum.GetValues<SubtitleCoverage>())
                                        {
                                            <option value="@coverage">@PolicyText.Coverage(coverage)</option>
                                        }
                                    </select>
                                    @if (Settings.Coverage != SubtitleCoverage.Both)
                                    {
                                        <small class="form-text text-muted d-block">@PolicyText.CoverageHelp(Settings.Coverage)</small>
                                    }
                                </div>
                            }
                            <div class="col-6">
                                <div class="option-label text-muted small mb-1">@PolicyText.ImpairedName(TrackType)</div>
                                <select class="form-select form-select-sm" value="@Settings.Impaired"
                                        @onchange="e => Settings.Impaired = Enum.Parse<ExtraPolicy>(e.Value?.ToString() ?? nameof(ExtraPolicy.Keep))">
                                    @foreach (var policy in Enum.GetValues<ExtraPolicy>())
                                    {
                                        <option value="@policy">@PolicyText.Extra(policy, PolicyText.ImpairedBetter(TrackType))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <div class="option-label text-muted small mb-1">@PolicyText.CommentaryName(TrackType)</div>
                                <select class="form-select form-select-sm" value="@Settings.Commentary"
                                        @onchange="e => Settings.Commentary = Enum.Parse<ExtraPolicy>(e.Value?.ToString() ?? nameof(ExtraPolicy.Keep))">
                                    @foreach (var policy in Enum.GetValues<ExtraPolicy>())
                                    {
                                        <option value="@policy">@PolicyText.Extra(policy, PolicyText.CommentaryBetter(TrackType))</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <small class="form-text text-muted d-block">To set this for one language, click it in the list above.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label mb-0">Rules by original language</label>
                        <small class="form-text text-muted d-block mb-2">A different list of languages to keep when a film or show is originally in a given language. Everything else stays the same.</small>
                        @foreach (var languageCase in Settings.Cases)
                        {
                            var current = languageCase;
                            <LanguageCaseEditor @key="current" Case="current" TrackType="TrackType" Settings="Settings"
                                                Taken="TakenOriginals(current)" AutoFocus="current == _newCase"
                                                OnRemove="() => Settings.Cases.Remove(current)"
                                                OnChange="StateHasChanged"/>
                        }
                        @if (Settings.Cases.Count > 0)
                        {
                            <small class="form-text text-muted d-block mb-2">All other original languages use the list above.</small>
                        }
                        @if (Settings.Cases.All(c => c.OriginalLanguages.Count > 0))
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="AddCase">
                                <i class="bi bi-plus-lg me-1"></i>Add original language rule
                            </button>
                        }
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <InputCheckbox id="@($"assumeUnd{TrackTypeLabel}")" class="form-check-input"
                                       @bind-Value="Settings.AssumeUndeterminedIsOriginal"/>
                        <label class="form-check-label" for="@($"assumeUnd{TrackTypeLabel}")">Treat one undetermined
                            @(TrackTypeLabel.ToLower()) track as the original language</label>
                        <small class="form-text text-muted d-block">When a file has exactly one @(TrackTypeLabel.ToLower())
                            track with no language set, it counts as the original language reported by Sonarr or Radarr.
                            To always keep undetermined tracks, add Undetermined to the languages above.</small>
                    </div>

                    @if (!IsAudio)
                    {
                        <div class="mb-3 form-check form-switch">
                            <InputCheckbox id="@($"excludeCodecs{TrackTypeLabel}")" class="form-check-input"
                                           @bind-Value="Settings.ExcludeCodecs"/>
                            <label class="form-check-label" for="@($"excludeCodecs{TrackTypeLabel}")">Remove selected
                                subtitle formats</label>
                            <small class="form-text text-muted d-block">Useful for dropping image subtitles like PGS or
                                VobSub.</small>
                        </div>

                        @if (Settings.ExcludeCodecs)
                        {
                            <div class="mb-3 ms-4">
                                <CodecSelector SelectedItems="Settings.ExcludedCodecs"/>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }

    @* --- Default Track --- *@
    <div class="mb-3">
        <label class="form-label mb-1">@(IsAudio ? "Default audio track" : "Default subtitle")</label>
        <select class="form-select form-select-sm" style="max-width: 320px;"
                value="@Settings.DefaultStrategy"
                @onchange="e => Settings.DefaultStrategy = Enum.Parse<DefaultTrackStrategy>(e.Value?.ToString() ?? nameof(DefaultTrackStrategy.DontChange))">
            <option value="@nameof(DefaultTrackStrategy.DontChange)">Don't change</option>
            <option value="@nameof(DefaultTrackStrategy.SpecCompliant)">Let the player choose</option>
            <option value="@nameof(DefaultTrackStrategy.ForceFirstLanguage)"
                    disabled="@(!HasLanguagePriority)">
                First language in the list@(!HasLanguagePriority ? " (add a language first)" : "")
            </option>
            @if (!IsAudio)
            {
                <option value="@nameof(DefaultTrackStrategy.ForceFirstLanguageForced)"
                        disabled="@(!HasLanguagePriority)">
                    Forced subtitles of the first language@(!HasLanguagePriority ? " (add a language first)" : "")
                </option>
            }
        </select>
        <small class="form-text text-muted d-block">
            @switch (Settings.DefaultStrategy)
            {
                case DefaultTrackStrategy.SpecCompliant:
                    <text>Commentary, @(IsAudio ? "audio description" : "SDH") and dub tracks are never the default. Your
                        player picks from the rest.</text>
                    break;
                case DefaultTrackStrategy.ForceFirstLanguage:
                    <text>The first language in your list that the file has becomes the default. For players without
                        language settings.</text>
                    break;
                case DefaultTrackStrategy.ForceFirstLanguageForced:
                    <text>A forced subtitle of the first language becomes the default, so the player only subtitles
                        foreign dialogue. If there isn't one, the full subtitle of that language is used.</text>
                    break;
                default:
                    <text>Original default flags from the source file are preserved.</text>
                    break;
            }
        </small>
    </div>

    @* --- Track Order --- *@
    <div class="mb-3">
        <label class="form-label mb-1">@(IsAudio ? "Audio track order" : "Subtitle order")</label>
        <select class="form-select form-select-sm" style="max-width: 320px;"
                value="@Settings.ReorderStrategy"
                @onchange="e => Settings.ReorderStrategy = Enum.Parse<TrackReorderStrategy>(e.Value?.ToString() ?? nameof(TrackReorderStrategy.DontReorder))">
            <option value="@nameof(TrackReorderStrategy.DontReorder)">Don't change</option>
            <option value="@nameof(TrackReorderStrategy.Alphabetical)">A to Z by language</option>
            <option value="@nameof(TrackReorderStrategy.MatchLanguagePriority)"
                    disabled="@(!HasLanguagePriority)">
                Same as the language list@(!HasLanguagePriority ? " (add a language first)" : "")
            </option>
        </select>
        <small class="form-text text-muted d-block">
            @switch (Settings.ReorderStrategy)
            {
                case TrackReorderStrategy.Alphabetical:
                    <text>Tracks are sorted A-Z by language. Within a language the file's own order is kept. Requires
                        remux.</text>
                    break;
                case TrackReorderStrategy.MatchLanguagePriority:
                    <text>
                        Tracks are sorted like the language list. Within a language the file's own order is kept.
                        Requires remux.</text>
                    break;
                default:
                    <text>Original track order from the source file is preserved.</text>
                    break;
            }
        </small>
    </div>

    @* --- Track Names --- *@
    <div class="mb-3 form-check form-switch">
        <InputCheckbox id="@($"standardize{TrackTypeLabel}")" class="form-check-input"
                       @bind-Value="Settings.StandardizeTrackNames" @bind-Value:after="OnStandardizeToggled"/>
        <label class="form-check-label" for="@($"standardize{TrackTypeLabel}")">Standardize @(TrackTypeLabel.ToLower())
            track names</label>
        <small class="form-text text-muted d-block">Rename @(TrackTypeLabel.ToLower()) tracks during conversion using a
            template.</small>
    </div>

    @if (Settings.StandardizeTrackNames)
    {
        <div class="mb-3 ms-4">
            <div class="option-label text-muted small mb-1">Default template</div>
            <InputText id="@($"trackNameTemplate{TrackTypeLabel}")" class="form-control form-control-sm"
                       @bind-Value="Settings.TrackNameTemplate"/>
            <small class="form-text text-muted d-block">
                Placeholders: <code>{language}</code>, <code>{lang}</code>, <code>{code}</code>,
                <code>{nativelanguage}</code>, <code>{variant}</code>,
                <code>{codec}</code>,
                @if (IsAudio)
                {
                    <code>{channels}</code>
                    <text>,</text>
                }
                <code>{trackname}</code>,
                <code>{hi}</code>, <code>{forced}</code>, <code>{commentary}</code>, <code>{visualimpaired}</code>,
                <code>{original}</code>, <code>{dub}</code>, <code>{flags}</code>.
                <code>{code}</code> is the language code (FR-CA), <code>{variant}</code> the regional marker (VFQ).
                Leave empty to clear all track names.
            </small>

            @if (HasClearWarning)
            {
                <small class="form-text text-warning d-block mt-1">
                    <i class="bi bi-exclamation-triangle me-1"></i>All @(TrackTypeLabel.ToLower()) track names will be
                    cleared during conversion.
                </small>
            }

            @if (HasDubWarning)
            {
                <small class="form-text text-warning d-block mt-1">
                    <i class="bi bi-exclamation-triangle me-1"></i>Template does not include <code>{dub}</code> or
                    <code>{flags}</code>.
                    Dub tracks in MKV files won't preserve their classification after remux since MKV has no native dub
                    flag.
                </small>
            }

            @if (!string.IsNullOrWhiteSpace(Settings.TrackNameTemplate))
            {
                <div class="mt-2 text-muted small">
                    <i class="bi bi-eye me-1"></i>Preview:
                    <div class="mt-1">
                        @foreach (var track in GetPreviewTracks())
                        {
                            var template = Settings.ResolveTemplate(track);
                            var resolved = track.ApplyTrackNameTemplate(template);
                            var isOverride = template != Settings.TrackNameTemplate;
                            <div>
                                <code>@(resolved ?? "(empty)")</code>
                                @if (isOverride)
                                {
                                    <span class="text-info ms-1" style="font-size: 0.75rem;">override</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mt-3">
                <a class="text-decoration-none small" data-bs-toggle="collapse"
                   href="#@($"flagOverrides{TrackTypeLabel}")" role="button">
                    <i class="bi bi-sliders me-1"></i>Flag-specific overrides
                </a>
            </div>

            <div class="collapse @(_hasOverrides ? "show" : "")" id="@($"flagOverrides{TrackTypeLabel}")">
                <div class="d-flex flex-column gap-2 mt-2 ms-2 border-start ps-3">
                    @foreach (var flag in TrackFlagExtensions.All)
                    {
                        var currentFlag = flag;
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge text-bg-secondary" style="width: 110px;">
                                <i class="bi @FlagIcon(flag) me-1"></i>@flag.GetDisplayName()
                            </span>
                            <input type="text"
                                   class="form-control form-control-sm"
                                   style="max-width: 300px;"
                                   placeholder="(uses default)"
                                   value="@GetOverride(currentFlag)"
                                   @onchange="e => SetOverride(currentFlag, e.Value?.ToString())"/>
                        </div>
                    }
                </div>
                <small class="text-muted d-block mt-2">Leave blank to use the default template. First matching flag
                    wins.</small>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] [EditorRequired] public TrackSettings Settings { get; set; } = default!;

    [Parameter] [EditorRequired] public MediaTrackType TrackType { get; set; }

    private string TrackTypeLabel => TrackType == MediaTrackType.Audio ? "Audio" : "Subtitle";
    private bool IsAudio => TrackType == MediaTrackType.Audio;
    private bool HasLanguagePriority =>
        Settings.AllowedLanguages.Count > 0
        || Settings.Cases.Any(c => c.OriginalLanguages.Count > 0 && c.Languages.Count > 0);

    private bool _moreOpen;

    // What is set behind the fold, so nothing configured is out of sight while it is closed.
    private string MoreSummary
    {
        get
        {
            var parts = new List<string>();
            var types = PolicyText.Summary(Settings, TrackType, onlyChanges: true).TrimEnd('.');
            if (types.Length > 0)
            {
                parts.Add(types);
            }

            if (Settings.Cases.Count > 0)
            {
                parts.Add(Settings.Cases.Count == 1 ? "1 original language rule" : $"{Settings.Cases.Count} original language rules");
            }

            if (Settings.ExcludeCodecs && Settings.ExcludedCodecs.Count > 0)
            {
                parts.Add($"{Settings.ExcludedCodecs.Count} format{(Settings.ExcludedCodecs.Count == 1 ? "" : "s")} removed");
            }

            return string.Join(" · ", parts);
        }
    }

    // Each original language belongs to one rule, so order never matters.
    private List<IsoLanguage> TakenOriginals(LanguageCase except)
    {
        return Settings.Cases.Where(c => c != except).SelectMany(c => c.OriginalLanguages).ToList();
    }
    private string DefaultTemplate => IsAudio ? "{language} {channels} {dub}" : "{language} {dub}";

    private string PreviewLanguage =>
        Settings.AllowedLanguages.Count > 0 ? Settings.AllowedLanguages[0].Language.Name : "English";

    private string? SecondLanguage =>
        Settings.AllowedLanguages.Count > 1 ? Settings.AllowedLanguages[1].Language.Name : null;

    // A regional sample only when a template asks for {variant} and the first
    // language is not one already, so the preview shows what the marker looks like.
    private bool ShowVariantSample =>
        Settings.TrackNameOverrides.Values.Prepend(Settings.TrackNameTemplate)
            .Any(t => t?.Contains("{variant}", StringComparison.OrdinalIgnoreCase) == true)
        && !IsoLanguage.Find(PreviewLanguage).IsVariant;

    private List<TrackSnapshot> GetPreviewTracks()
    {
        if (IsAudio)
        {
            var tracks = new List<TrackSnapshot>
            {
                new() { Type = MediaTrackType.Audio, LanguageName = PreviewLanguage, Codec = "TrueHD", AudioChannels = 8, IsOriginal = true },
                new() { Type = MediaTrackType.Audio, LanguageName = PreviewLanguage, Codec = "E-AC-3", AudioChannels = 6 },
                new() { Type = MediaTrackType.Audio, LanguageName = PreviewLanguage, Codec = "AAC", AudioChannels = 2, IsCommentary = true }
            };
            if (SecondLanguage != null)
            {
                tracks.Add(new TrackSnapshot { Type = MediaTrackType.Audio, LanguageName = SecondLanguage, Codec = "E-AC-3", AudioChannels = 6, IsDub = true });
            }

            if (ShowVariantSample)
            {
                tracks.Add(new TrackSnapshot { Type = MediaTrackType.Audio, LanguageName = "French (Canada)", Codec = "AC-3", AudioChannels = 6 });
            }

            return tracks;
        }
        else
        {
            var tracks = new List<TrackSnapshot>
            {
                new() { Type = MediaTrackType.Subtitles, LanguageName = PreviewLanguage, Codec = "SRT" },
                new() { Type = MediaTrackType.Subtitles, LanguageName = PreviewLanguage, Codec = "SRT", IsHearingImpaired = true },
                new() { Type = MediaTrackType.Subtitles, LanguageName = PreviewLanguage, Codec = "PGS", IsForced = true }
            };
            if (SecondLanguage != null)
            {
                tracks.Add(new TrackSnapshot { Type = MediaTrackType.Subtitles, LanguageName = SecondLanguage, Codec = "SRT", IsDub = true });
            }

            if (ShowVariantSample)
            {
                tracks.Add(new TrackSnapshot { Type = MediaTrackType.Subtitles, LanguageName = "French (Canada)", Codec = "SRT" });
            }

            return tracks;
        }
    }

    private bool _hasOverrides => Settings.TrackNameOverrides.Any(kv => !string.IsNullOrEmpty(kv.Value));

    private bool HasClearWarning =>
        Settings.StandardizeTrackNames && string.IsNullOrWhiteSpace(Settings.TrackNameTemplate);

    private bool HasDubWarning =>
        Settings.StandardizeTrackNames
        && !string.IsNullOrEmpty(Settings.TrackNameTemplate)
        && !Settings.TrackNameTemplate.Contains("{dub}", StringComparison.OrdinalIgnoreCase)
        && !Settings.TrackNameTemplate.Contains("{flags}", StringComparison.OrdinalIgnoreCase)
        && !Settings.TrackNameOverrides.ContainsKey(TrackFlag.Dub);

    private static string FlagIcon(TrackFlag flag)
    {
        return flag switch
        {
            TrackFlag.HearingImpaired => "bi-ear",
            TrackFlag.Forced => "bi-lock",
            TrackFlag.Commentary => "bi-chat-quote",
            TrackFlag.VisualImpaired => "bi-eye",
            TrackFlag.Dub => "bi-translate",
            _ => "bi-question-circle"
        };
    }

    private string GetOverride(TrackFlag flag)
    {
        return Settings.TrackNameOverrides.TryGetValue(flag, out var value) ? value : "";
    }

    private void SetOverride(TrackFlag flag, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            Settings.TrackNameOverrides.Remove(flag);
        }
        else
        {
            Settings.TrackNameOverrides[flag] = value;
        }
    }

    private LanguageCase? _newCase;

    // A new rule starts as a copy of the main list: most people tweak it, not rebuild it.
    private void AddCase()
    {
        _newCase = new LanguageCase { Languages = Settings.AllowedLanguages.LazyClone() };
        Settings.Cases.Add(_newCase);
    }

    private void OnEnabledToggled()
    {
        if (Settings.Enabled && Settings.AllowedLanguages.Count == 0 && Settings.Cases.Count == 0 && IsAudio)
        {
            Settings.AllowedLanguages.Add(new LanguagePreference(IsoLanguage.OriginalLanguage));
        }
    }

    private void OnStandardizeToggled()
    {
        if (Settings.StandardizeTrackNames && string.IsNullOrEmpty(Settings.TrackNameTemplate))
        {
            Settings.TrackNameTemplate = DefaultTemplate;
        }
    }

}
