@typeparam TCodec where TCodec : struct, Enum

<TagSelector TItem="TCodec" SelectedItems="SelectedItems" OnSearchInput="OnSearchInput" ShowListOnFocus="true">
    <TagTemplate>@context.DisplayName()</TagTemplate>
    <ListTemplate>@context.DisplayName()</ListTemplate>
</TagSelector>

@code {
    [Parameter] [EditorRequired] public required List<TCodec> SelectedItems { get; set; }
    [Parameter] [EditorRequired] public required IReadOnlyList<TCodec> Values { get; set; }

    private Task<List<TCodec>> OnSearchInput(string query)
    {
        var results = Values
            .Where(c => !SelectedItems.Contains(c))
            .Where(c => string.IsNullOrEmpty(query)
                        || c.DisplayName().Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToList();

        return Task.FromResult(results);
    }

}
