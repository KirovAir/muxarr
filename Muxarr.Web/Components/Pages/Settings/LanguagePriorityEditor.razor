@using Muxarr.Web.Attributes
@using Muxarr.Web.Helpers
@attribute [type: RenderModeInteractiveServer]

<div class="lpe-container">
    @foreach (var group in Languages.Groups())
    {
        var head = group[0][0];
        var groupStart = Languages.IndexOf(head);
        var isSet = group.Count > 1 || group[0].Count > 1;
        var isOpen = _openHead == head;
        var isDragOver = _dragOverIndex == groupStart;

        <div class="lpe-item @(isDragOver ? "lpe-item-dragover" : "") @(_dragSourceIndex == groupStart ? "lpe-item-dragging" : "") @(isOpen ? "lpe-item-open" : "") @(head.IsOriginalLanguagePlaceholder && !isSet ? "lpe-item-original" : "")"
             draggable="true" tabindex="0" role="button"
             @ondragstart="() => OnDragStart(groupStart)"
             @ondragenter="() => OnDragEnter(groupStart)"
             @ondragover:preventDefault
             @ondrop="() => OnDrop(groupStart)"
             @ondragend="OnDragEnd"
             @onclick="() => ToggleGroup(head)"
             @onkeydown="e => OnRowKey(e, head)">

            <i class="bi bi-grip-vertical lpe-drag-handle"></i>
            @foreach (var member in group[0])
            {
                @if (member != group[0][0])
                {
                    <span class="lpe-plus">+</span>
                }
                @if (member.IsOriginalLanguagePlaceholder)
                {
                    <i class="bi bi-film lpe-original-icon"></i>
                }
                <span class="lpe-lang-name">@Label(member)</span>
                @if (!member.IsOriginalLanguagePlaceholder && !isSet)
                {
                    <span class="lpe-lang-code">@member.ThreeLetterCode</span>
                }
                @if (PolicyText.Overrides(member, TrackType) is { Length: > 0 } note)
                {
                    <span class="lpe-note">@note</span>
                }
            }

            <ToolTip Tip="@(isSet ? "Remove this fallback set" : $"Remove {Label(head)}")">
                <button type="button" class="lpe-icon-btn lpe-remove-btn" @onclick="() => RemoveGroup(head)"
                        @onclick:stopPropagation>
                    <i class="bi bi-x-lg"></i>
                </button>
            </ToolTip>
        </div>

        @for (var tier = 1; tier < group.Count; tier++)
        {
            <div class="lpe-fallback-line">@FallbackLead(group[0].Count, tier) <b>@Names(group[tier], ", ")</b>@Notes(group[tier])</div>
        }

        @if (isOpen)
        {
            <div class="lpe-panel">
                @if (isSet || _pendingTier >= 0)
                {
                    @for (var tier = 0; tier < group.Count + (_pendingTier >= 0 ? 1 : 0); tier++)
                    {
                        var currentTier = tier;
                        var members = tier < group.Count ? group[tier] : new List<LanguagePreference>();
                        <div class="lpe-level">
                            <div class="lpe-level-label">@(tier == 0 ? "Preferred languages" : FallbackLead(group[0].Count, tier).TrimEnd(':'))</div>
                            @foreach (var member in members)
                            {
                                var current = member;
                                <div class="lpe-member @(_openLanguage == current ? "lpe-member-open" : "")" tabindex="0" role="button"
                                     @onclick="() => ToggleLanguage(current)" @onkeydown="e => OnMemberKey(e, current)">
                                    @if (current.IsOriginalLanguagePlaceholder)
                                    {
                                        <i class="bi bi-film lpe-original-icon"></i>
                                    }
                                    <span class="lpe-lang-name">@Label(current)</span>
                                    @if (PolicyText.Overrides(current, TrackType) is { Length: > 0 } memberNote)
                                    {
                                        <span class="lpe-note">@memberNote</span>
                                    }
                                    <ToolTip Tip="@($"Remove {Label(current)}")">
                                        <button type="button" class="lpe-icon-btn lpe-remove-btn"
                                                @onclick="() => RemoveLanguage(current)" @onclick:stopPropagation>
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </ToolTip>
                                </div>
                                @if (_openLanguage == current)
                                {
                                    <div class="lpe-language-settings">@LanguageSettings(current, false)</div>
                                }
                            }
                            @if (tier > 0 || group.Count > 1)
                            {
                                <div class="lpe-level-add">
                                    <AutoComplete TItem="IsoLanguage" SearchInput=""
                                                  OnSearchInput="OnSetSearchInput"
                                                  OnSelectItem="item => AddToTier(head, currentTier, item)"
                                                  Placeholder="@(tier == 0 ? "Add preferred language" : "Add fallback language")">
                                        <ListTemplate>@ListEntry(context)</ListTemplate>
                                    </AutoComplete>
                                    @if (!HasOriginalLanguage)
                                    {
                                        <button type="button" class="btn btn-link btn-sm text-muted p-0"
                                                @onclick="() => AddToTier(head, currentTier, IsoLanguage.OriginalLanguage)">
                                            <i class="bi bi-film me-1"></i>Add original language
                                        </button>
                                    }
                                </div>
                            }
                            @if (tier == 0 && group.Count > 1)
                            {
                                <small class="lpe-hint">Keep every preferred language that is available.</small>
                            }
                            else if (tier >= group.Count)
                            {
                                <small class="lpe-hint">Leave empty to skip.</small>
                            }
                        </div>
                    }
                    <div class="lpe-panel-actions">
                        @if (_pendingTier < 0)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="AddLevel">
                                <i class="bi bi-plus-lg me-1"></i>Add another fallback
                            </button>
                        }
                        <button type="button" class="btn btn-link btn-sm p-0 text-muted" @onclick="CloseGroup">Done</button>
                    </div>
                }
                else
                {
                    @LanguageSettings(head, true)
                }
            </div>
        }
    }

    @if (Languages.Count == 0)
    {
        <small class="form-text text-warning d-block mb-1">
            <i class="bi bi-exclamation-triangle me-1"></i>@(IsAudio ? "Add a language. Otherwise, files keep only one audio track." : "Add a language. Otherwise, all subtitles will be removed.")
        </small>
    }

    <div class="lpe-add-row">
        <div class="lpe-add-wrapper">
            <AutoComplete TItem="IsoLanguage"
                          SearchInput="@_searchInput"
                          OnSearchInput="OnSearchInput"
                          OnSelectItem="OnSelect"
                          Placeholder="Add language">
                <ListTemplate>@ListEntry(context)</ListTemplate>
            </AutoComplete>
        </div>
        @if (!HasOriginalLanguage)
        {
            <ToolTip Tip="Uses the original language reported by Sonarr or Radarr.">
                <button type="button" class="btn btn-link btn-sm text-muted p-0" @onclick="() => OnSelect(IsoLanguage.OriginalLanguage)">
                    <i class="bi bi-film me-1"></i>Add original language
                </button>
            </ToolTip>
        }
    </div>

    @foreach (var variant in SelectedVariants)
    {
        <small class="form-text text-muted d-block mt-2">
            <strong>@variant.DisplayName</strong> also keeps @variant.Base.Name tracks with no variant set. Other
            @variant.Base.Name variants are removed.
        </small>
    }
</div>

@code {
    [Parameter] [EditorRequired] public required List<LanguagePreference> Languages { get; set; }
    [Parameter] public MediaTrackType TrackType { get; set; }

    // The profile's policy, so a language's settings can say what "Same as profile" means.
    [Parameter] [EditorRequired] public required TrackSettings Settings { get; set; }

    // Raised when a language is added or removed, for parents whose options depend on the list.
    [Parameter] public EventCallback OnChange { get; set; }

    [CascadingParameter] public required IModalService Modal { get; set; }

    private bool IsAudio => TrackType == MediaTrackType.Audio;

    private string _searchInput = string.Empty;

    // Open state points at rows, not indexes, since every edit shifts indexes.
    private LanguagePreference? _openHead;
    private LanguagePreference? _openLanguage;
    private int _pendingTier = -1;
    private int _dragSourceIndex = -1;
    private int _dragOverIndex = -1;

    // A shared tier without a fallback means nothing, so it never reaches the profile that way.
    protected override void OnParametersSet()
    {
        Languages.AnchorTop();
        Languages.Tidy();
    }

    // Explained only when the base is absent; with both listed the base keeps everything anyway.
    private List<IsoLanguage> SelectedVariants =>
        Languages.Select(x => IsoLanguage.Find(x.Name))
            .Where(l => l.IsVariant && Languages.All(x => x.Name != l.Base.Name))
            .ToList();

    private bool HasOriginalLanguage => Languages.Any(l => l.IsOriginalLanguagePlaceholder);

    private static string Label(LanguagePreference pref)
    {
        return pref.IsOriginalLanguagePlaceholder ? "Original language" : pref.DisplayName;
    }

    private static string Names(List<LanguagePreference> languages, string joiner)
    {
        return string.Join(joiner, languages.Select(Label));
    }

    private string Notes(List<LanguagePreference> languages)
    {
        var notes = languages.Select(l => PolicyText.Overrides(l, TrackType)).Where(n => n.Length > 0).ToList();
        return notes.Count == 0 ? "" : " · " + string.Join(" · ", notes);
    }

    private static string ListEntry(IsoLanguage language)
    {
        var native = language.NativeName != language.Name ? $" · {language.NativeName}" : "";
        var code = language.ThreeLetterCode != null ? $" ({language.ThreeLetterCode.ToUpperInvariant()})" : "";
        return language.DisplayName + native + code;
    }

    // "If unavailable:", "If neither is available:", "If none are available:", then "If still unavailable:".
    private static string FallbackLead(int preferred, int tier)
    {
        if (tier > 1)
        {
            return "If still unavailable:";
        }

        return preferred switch
        {
            1 => "If unavailable:",
            2 => "If neither is available:",
            _ => "If none are available:"
        };
    }

    private List<List<LanguagePreference>> OpenGroup =>
        Languages.Groups().FirstOrDefault(g => g[0][0] == _openHead) ?? [];

    // --- Open and close ---

    private void ToggleGroup(LanguagePreference head)
    {
        var open = _openHead == head;
        CloseGroup();
        if (!open)
        {
            _openHead = head;
        }
    }

    private void OnRowKey(KeyboardEventArgs e, LanguagePreference head)
    {
        if (e.Key is "Enter" or " ")
        {
            ToggleGroup(head);
        }
    }

    private void ToggleLanguage(LanguagePreference language)
    {
        _openLanguage = _openLanguage == language ? null : language;
    }

    private void OnMemberKey(KeyboardEventArgs e, LanguagePreference language)
    {
        if (e.Key is "Enter" or " ")
        {
            ToggleLanguage(language);
        }
    }

    // A set that ends up without a fallback is plain languages again.
    private void CloseGroup()
    {
        _openHead = null;
        _openLanguage = null;
        _pendingTier = -1;
        Languages.Tidy();
    }

    // --- Sets ---

    // An empty fallback level waiting for its first language; from a plain
    // language this turns its panel into the set editor.
    private void AddLevel()
    {
        _pendingTier = Math.Max(1, OpenGroup.Count);
    }

    // A language already in the list as a plain row is moved into the set rather
    // than refused, so "Norwegian, Bokmål" can become a pair without re-adding.
    private async Task AddToTier(LanguagePreference head, int tier, IsoLanguage language)
    {
        var existing = Languages.FirstOrDefault(l => l.Name == language.Name);
        if (existing != null)
        {
            var ownGroup = Languages.Groups().FirstOrDefault(g => g[0][0] == existing);
            if (existing == head || ownGroup == null || ownGroup.Sum(t => t.Count) > 1)
            {
                return;
            }

            Languages.RemoveGroup(Languages.IndexOf(existing));
        }

        Languages.AddToGroup(Languages.IndexOf(head), tier, existing ?? new LanguagePreference(language));
        if (tier == _pendingTier)
        {
            _pendingTier = -1;
        }

        await OnChange.InvokeAsync();
    }

    private async Task RemoveLanguage(LanguagePreference language)
    {
        Languages.RemoveFromGroup(Languages.IndexOf(language));
        _openLanguage = null;
        if (_openHead != null && (!Languages.Contains(_openHead) || _openHead.Relation != LanguageRelation.NewGroup))
        {
            CloseGroup();
        }

        await OnChange.InvokeAsync();
    }

    private async Task RemoveGroup(LanguagePreference head)
    {
        var group = Languages.Groups().FirstOrDefault(g => g[0][0] == head);
        if (group == null)
        {
            return;
        }

        var isSet = group.Count > 1 || group[0].Count > 1;
        if (isSet && !await Modal.ShowConfirm("Remove this fallback set?"))
        {
            return;
        }

        Languages.RemoveGroup(Languages.IndexOf(head));
        CloseGroup();
        await OnChange.InvokeAsync();
    }

    // --- Drag and drop (whole sets move together) ---

    private void OnDragStart(int index)
    {
        _dragSourceIndex = index;
        _dragOverIndex = -1;
        CloseGroup();
    }

    private void OnDragEnter(int index)
    {
        if (_dragSourceIndex >= 0)
        {
            // Highlight where the block will actually land, and never inside itself.
            _dragOverIndex = Languages.DropTarget(_dragSourceIndex, index);
        }
    }

    private async Task OnDrop(int targetIndex)
    {
        if (_dragSourceIndex >= 0)
        {
            Languages.Move(_dragSourceIndex, targetIndex);
        }

        _dragSourceIndex = -1;
        _dragOverIndex = -1;
        await OnChange.InvokeAsync();
    }

    private void OnDragEnd()
    {
        _dragSourceIndex = -1;
        _dragOverIndex = -1;
    }

    // --- Add ---

    private Task OnSelect(IsoLanguage item)
    {
        _searchInput = string.Empty;
        if (Languages.All(l => l.Name != item.Name))
        {
            Languages.Add(new LanguagePreference(item));
        }

        return OnChange.InvokeAsync();
    }

    private Task<List<IsoLanguage>> OnSearchInput(string input)
    {
        return Task.FromResult(IsoLanguage.Search(input)
            .Where(l => Languages.All(p => p.Name != l.Name))
            .Take(10)
            .ToList());
    }

    // Inside a set, a plain row elsewhere in the list is still offered: picking it moves it in.
    private Task<List<IsoLanguage>> OnSetSearchInput(string input)
    {
        var unavailable = Languages.Groups()
            .Where(g => g.Count > 1 || g[0].Count > 1 || g[0][0] == _openHead)
            .SelectMany(g => g.SelectMany(t => t))
            .ToList();
        return Task.FromResult(IsoLanguage.Search(input)
            .Where(l => unavailable.All(p => p.Name != l.Name))
            .Take(10)
            .ToList());
    }

    // --- Language settings ---

    private RenderFragment LanguageSettings(LanguagePreference pref, bool offerFallback) => __builder =>
    {
        <div class="lpe-settings">
            @if (!IsAudio)
            {
                <div>
                    <label class="lpe-advanced-label">Full and forced subtitles</label>
                    <select class="form-select form-select-sm" value="@(pref.Coverage?.ToString() ?? "")"
                            @onchange="e => pref.Coverage = Enum.TryParse<SubtitleCoverage>(e.Value?.ToString(), out var v) ? v : null">
                        <option value="">Same as profile: @PolicyText.Coverage(Settings.Coverage)</option>
                        @foreach (var coverage in Enum.GetValues<SubtitleCoverage>())
                        {
                            <option value="@coverage">@PolicyText.Coverage(coverage)</option>
                        }
                    </select>
                </div>
            }
            <div>
                <label class="lpe-advanced-label">@PolicyText.ImpairedName(TrackType)</label>
                <select class="form-select form-select-sm" value="@(pref.Impaired?.ToString() ?? "")"
                        @onchange="e => pref.Impaired = Enum.TryParse<ExtraPolicy>(e.Value?.ToString(), out var v) ? v : null">
                    <option value="">Same as profile: @PolicyText.Extra(Settings.Impaired, PolicyText.ImpairedBetter(TrackType))</option>
                    @foreach (var policy in Enum.GetValues<ExtraPolicy>())
                    {
                        <option value="@policy">@PolicyText.Extra(policy, PolicyText.ImpairedBetter(TrackType))</option>
                    }
                </select>
            </div>
            <div>
                <label class="lpe-advanced-label">@PolicyText.CommentaryName(TrackType)</label>
                <select class="form-select form-select-sm" value="@(pref.Commentary?.ToString() ?? "")"
                        @onchange="e => pref.Commentary = Enum.TryParse<ExtraPolicy>(e.Value?.ToString(), out var v) ? v : null">
                    <option value="">Same as profile: @PolicyText.Extra(Settings.Commentary, PolicyText.CommentaryBetter(TrackType))</option>
                    @foreach (var policy in Enum.GetValues<ExtraPolicy>())
                    {
                        <option value="@policy">@PolicyText.Extra(policy, PolicyText.CommentaryBetter(TrackType))</option>
                    }
                </select>
            </div>
            <div class="lpe-settings-rule"></div>
            <div>
                <label class="lpe-advanced-label">Maximum tracks</label>
                <select class="form-select form-select-sm"
                        value="@(pref.MaxTracks?.ToString() ?? "")"
                        @onchange="e => SetMaxTracks(pref, e.Value?.ToString())">
                    <option value="">No limit</option>
                    @foreach (var n in new[] { 1, 2, 3 })
                    {
                        <option value="@n">@MaxTracksLabel(n)</option>
                    }
                </select>
                @if (!IsAudio)
                {
                    <small class="lpe-hint">Full and forced subtitles are counted separately.</small>
                }
            </div>
            @if (pref.MaxTracks != null)
            {
                <div>
                    <label class="lpe-advanced-label">Which to keep</label>
                    @if (IsAudio)
                    {
                        <select class="form-select form-select-sm" value="@pref.QualityStrategy.ToString()"
                                @onchange="e => pref.QualityStrategy = Enum.TryParse<AudioQualityStrategy>(e.Value?.ToString(), out var v) ? v : AudioQualityStrategy.BestQuality">
                            <option value="@nameof(AudioQualityStrategy.BestQuality)">Prefer lossless audio</option>
                            <option value="@nameof(AudioQualityStrategy.MostChannels)">Prefer most channels</option>
                            <option value="@nameof(AudioQualityStrategy.SmallestSize)">Prefer smallest size</option>
                        </select>
                    }
                    else
                    {
                        <select class="form-select form-select-sm" value="@pref.SubtitleStrategy.ToString()"
                                @onchange="e => pref.SubtitleStrategy = Enum.TryParse<SubtitleQualityStrategy>(e.Value?.ToString(), out var v) ? v : SubtitleQualityStrategy.TextFirst">
                            <option value="@nameof(SubtitleQualityStrategy.TextFirst)">Prefer text subtitles</option>
                            <option value="@nameof(SubtitleQualityStrategy.ImageFirst)">Prefer image subtitles</option>
                            <option value="@nameof(SubtitleQualityStrategy.Accessibility)">Prefer SDH subtitles</option>
                        </select>
                    }
                </div>
            }
        </div>
        <div class="lpe-panel-actions">
            @if (offerFallback)
            {
                <button type="button" class="btn btn-link btn-sm p-0" @onclick="AddLevel">
                    <i class="bi bi-plus-lg me-1"></i>Add a fallback
                </button>
            }
            @if (pref.HasOverrides)
            {
                <button type="button" class="btn btn-link btn-sm p-0 text-muted" @onclick="() => ClearOverrides(pref)">
                    Reset to profile settings
                </button>
            }
            @if (offerFallback)
            {
                <button type="button" class="btn btn-link btn-sm p-0 text-muted" @onclick="CloseGroup">Done</button>
            }
        </div>
    };

    private string MaxTracksLabel(int n)
    {
        if (!IsAudio)
        {
            return $"{n} of each";
        }

        return n == 1 ? "Best track only" : $"Best {n} tracks";
    }

    // No limit means no preference either, so the row does not read as changed.
    private static void SetMaxTracks(LanguagePreference pref, string? value)
    {
        pref.MaxTracks = int.TryParse(value, out var v) ? v : null;
        if (pref.MaxTracks == null)
        {
            pref.QualityStrategy = AudioQualityStrategy.BestQuality;
            pref.SubtitleStrategy = SubtitleQualityStrategy.TextFirst;
        }
    }

    private static void ClearOverrides(LanguagePreference pref)
    {
        pref.MaxTracks = null;
        pref.Coverage = null;
        pref.Impaired = null;
        pref.Commentary = null;
        pref.QualityStrategy = AudioQualityStrategy.BestQuality;
        pref.SubtitleStrategy = SubtitleQualityStrategy.TextFirst;
    }

}
