@using Muxarr.Web.Helpers

@if (IsUnmodified)
{
    <ToolTip Tip="Tracks are left untouched">
        <span class="badge text-bg-success me-1">Unmodified</span>
    </ToolTip>
}
else
{
    @if (Settings.Enabled)
    {
        @foreach (var languageCase in Settings.Cases)
        {
            var originals = string.Join(", ", languageCase.OriginalLanguages.Select(l => l.DisplayName));
            @if (originals.Length == 0)
            {
                <ToolTip Tip="This rule is not used until it has an original language">
                    <span class="badge text-bg-warning me-1"><i class="bi bi-signpost-split me-1"></i>Choose an original language</span>
                </ToolTip>
            }
            else
            {
                <ToolTip Tip="@($"When the original language is {originals}: {Sentence(languageCase.Languages)}")">
                    <span class="badge text-bg-info me-1"><i class="bi bi-signpost-split me-1"></i>When @originals: @Sentence(languageCase.Languages)</span>
                </ToolTip>
            }
        }

        @if (Settings.Cases.Count > 0 && Settings.AllowedLanguages.Count > 0)
        {
            <span class="small text-secondary me-1">Otherwise:</span>
        }

        @foreach (var group in Settings.AllowedLanguages.Groups())
        {
            var head = group[0][0];
            var label = string.Join(" + ", group[0].Select(Label)) + Note(group[0]);

            @if (head.IsOriginalLanguagePlaceholder && group[0].Count == 1)
            {
                <ToolTip Tip="Tracks in the original language are kept">
                    <span class="badge text-bg-success me-1"><i class="bi bi-film me-1"></i>@label</span>
                </ToolTip>
            }
            else
            {
                <ToolTip Tip="@($"Tracks in {string.Join(" and ", group[0].Select(Label))} are kept")">
                    <span class="badge text-bg-success me-1">@label</span>
                </ToolTip>
            }

            @for (var tierIndex = 1; tierIndex < group.Count; tierIndex++)
            {
                var tier = group[tierIndex];
                var above = string.Join(" or ", group.Take(tierIndex).SelectMany(t => t).Select(Label));
                <ToolTip Tip="@($"Only kept when the file has no {above}")">
                    <span class="badge text-bg-secondary me-1"><i class="bi bi-arrow-return-right me-1"></i>@(string.Join(", ", tier.Select(Label)) + Note(tier))</span>
                </ToolTip>
            }
        }

        @if (Settings.AllowedLanguages.Count == 0)
        {
            <ToolTip Tip="@(Settings.Cases.Count == 0
                              ? (IsAudio ? "Files keep only one audio track" : "All subtitles are removed")
                              : "Files in any other original language lose their tracks")">
                <span class="badge text-bg-danger me-1">None</span>
            </ToolTip>
        }

        @if (Settings.AllowedLanguages.Count > 0 || Settings.Cases.Count > 0)
        {
            @if (HasTypePolicy)
            {
                <ToolTip Tip="@PolicyText.Summary(Settings, TrackType)">
                    <span class="badge text-bg-warning me-1">@PolicyText.Summary(Settings, TrackType, onlyChanges: true).TrimEnd('.')</span>
                </ToolTip>
            }

            @if (Settings.ExcludeCodecs && Settings.ExcludedCodecs.Count > 0)
            {
                <ToolTip Tip="@($"Removes {string.Join(", ", Settings.ExcludedCodecs.Select(c => c.DisplayName()))}")">
                    <span class="badge text-bg-warning me-1"><i class="bi bi-x-lg me-1"></i>@string.Join(", ", Settings.ExcludedCodecs.Select(c => c.DisplayName()))</span>
                </ToolTip>
            }

            @if (Settings.StandardizeTrackNames)
            {
                <ToolTip Tip="@($"Track names are standardized using: {Settings.TrackNameTemplate}")">
                    <span class="badge text-bg-info me-1"><i class="bi bi-magic me-1"></i>Rename</span>
                </ToolTip>
            }
        }
    }

    @switch (Settings.DefaultStrategy)
    {
        case DefaultTrackStrategy.SpecCompliant:
            <ToolTip Tip="Default track: commentary and accessibility tracks are never the default. The player picks from the rest.">
                <span class="badge text-bg-info me-1"><i class="bi bi-shield-check me-1"></i>Default: player chooses</span>
            </ToolTip>
            break;
        case DefaultTrackStrategy.ForceFirstLanguage:
            <ToolTip Tip="Default track: the first language in the list is marked as the default.">
                <span class="badge text-bg-info me-1"><i class="bi bi-pin-fill me-1"></i>Default: first language</span>
            </ToolTip>
            break;
        case DefaultTrackStrategy.ForceFirstLanguageForced:
            <ToolTip Tip="Default track: a forced subtitle of the first language, or its full subtitle when there is none">
                <span class="badge text-bg-info me-1"><i class="bi bi-pin-fill me-1"></i>Default: forced subtitles</span>
            </ToolTip>
            break;
    }

    @switch (Settings.ReorderStrategy)
    {
        case TrackReorderStrategy.Alphabetical:
            <ToolTip Tip="Reorders tracks alphabetically by language. Requires remux.">
                <span class="badge text-bg-info me-1"><i class="bi bi-sort-alpha-down me-1"></i>A-Z order</span>
            </ToolTip>
            break;
        case TrackReorderStrategy.MatchLanguagePriority:
            <ToolTip Tip="Reorders tracks to match the language list. Requires remux.">
                <span class="badge text-bg-info me-1"><i class="bi bi-sort-down-alt me-1"></i>List order</span>
            </ToolTip>
            break;
    }
}

@code {
    [Parameter] [EditorRequired] public TrackSettings Settings { get; set; } = null!;
    [Parameter] public MediaTrackType TrackType { get; set; }

    private bool IsAudio => TrackType == MediaTrackType.Audio;

    private bool IsUnmodified =>
        !Settings.Enabled
        && Settings.DefaultStrategy == DefaultTrackStrategy.DontChange
        && Settings.ReorderStrategy == TrackReorderStrategy.DontReorder;

    private bool HasTypePolicy =>
        (!IsAudio && Settings.Coverage != SubtitleCoverage.Both)
        || Settings.Impaired != ExtraPolicy.Keep
        || Settings.Commentary != ExtraPolicy.Keep;

    private static string Label(LanguagePreference pref)
    {
        return pref.IsOriginalLanguagePlaceholder ? "Original" : pref.DisplayName;
    }

    // " · forced subtitles only" when a language in the tier has its own settings.
    private string Note(List<LanguagePreference> tier)
    {
        var notes = tier.Select(p => PolicyText.Overrides(p, TrackType)).Where(n => n.Length > 0).ToList();
        return notes.Count == 0 ? "" : " · " + string.Join(" · ", notes);
    }

    // "Dutch, otherwise English; original language"
    private string Sentence(List<LanguagePreference> languages)
    {
        if (languages.Count == 0)
        {
            return IsAudio ? "one audio track" : "no subtitles";
        }

        return string.Join("; ", languages.Groups().Select(group =>
        {
            var text = string.Join(" + ", group[0].Select(Label)) + Note(group[0]);
            foreach (var tier in group.Skip(1))
            {
                text += ", otherwise " + string.Join(", ", tier.Select(Label)) + Note(tier);
            }

            return text;
        }));
    }

}
