<table class="table table-sm mb-0">
    <thead>
    <tr>
        <th style="width: 35px;">#</th>
        <th>Language</th>
        <th>Format</th>
        <th>Details</th>
    </tr>
    </thead>
    <tbody>
    @if (Current != null)
    {
        <MediaContainerDetail Current="Current" Plan="Plan" Previous="Previous"/>
    }
    @foreach (var item in KeptTracks)
    {
        @if (item.MuxedIn != null)
        {
            <tr>
                <td><i class="bi bi-file-earmark-text text-success"></i></td>
                <td><MediaTrackLabel Track="item.MuxedIn" ShowAllFlags="true"/></td>
                <td><code>@item.MuxedIn.Codec.FormatCodec()</code></td>
                <td>
                    <span class="badge bg-info text-white me-1">muxed in</span>
                    <span class="text-muted small">@item.MuxedIn.FileName(MediaPath ?? "")</span>
                </td>
            </tr>
            continue;
        }

        <MediaTrackDetail Track="item.Original"
                          Preview="item.Preview"
                          OriginalLanguage="@OriginalLanguage"
                          MovedFromPosition="item.MovedFromPosition"/>
    }
    @foreach (var (track, fileName) in ExtractedTracks)
    {
        <tr>
            <td>@track.Index</td>
            <td><MediaTrackLabel Track="track" ShowAllFlags="true"/></td>
            <td><code>@track.Codec.FormatCodec()</code></td>
            <td>
                <i class="bi bi-arrow-right text-warning me-1"></i>
                <span class="small text-warning-emphasis">@fileName</span>
            </td>
        </tr>
    }
    @foreach (var track in RemovedTracks)
    {
        <tr class="opacity-50">
            <td>@track.Index</td>
            <td>
                <MediaTrackLabel Track="track" ShowAllFlags="true"/>
            </td>
            <td><code>@track.Codec.FormatCodec()</code></td>
            <td><RemovedMark/></td>
        </tr>
    }
    @foreach (var sidecar in StayingSidecars)
    {
        <tr>
            <td><i class="bi bi-file-earmark-text text-success"></i></td>
            <td><MediaTrackLabel Track="sidecar" ShowAllFlags="true"/></td>
            <td><code>@sidecar.Codec.FormatCodec()</code></td>
            <td>
                <span class="badge bg-success-subtle text-success-emphasis me-1">file</span>
                <span class="text-muted small">@sidecar.FileName(MediaPath ?? "")</span>
                @if (Plan?.SubtitleDeletions.Any(d => d.Suffix == sidecar.Suffix) == true)
                {
                    <span class="badge bg-danger-subtle text-danger-emphasis ms-1">removed</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    [Parameter] [EditorRequired] public IEnumerable<IMediaTrack> Tracks { get; set; } = default!;
    [Parameter] public List<TrackPlan>? PreviewTracks { get; set; }
    [Parameter] [EditorRequired] public string? OriginalLanguage { get; set; }

    /// <summary>Container properties for this state, shown as rows above the tracks.</summary>
    [Parameter] public MediaSnapshot? Current { get; set; }
    [Parameter] public ConversionPlan? Plan { get; set; }
    [Parameter] public MediaSnapshot? Previous { get; set; }

    /// <summary>Subtitle files beside the video, shown after the embedded tracks.</summary>
    [Parameter] public IEnumerable<SubtitleFile>? Sidecars { get; set; }
    [Parameter] public string? MediaPath { get; set; }

    private record TrackWithPreview(IMediaTrack Original, TrackPlan? Preview, int? MovedFromPosition, SubtitleFile? MuxedIn = null);

    private List<TrackWithPreview> KeptTracks { get; set; } = [];
    private List<IMediaTrack> RemovedTracks { get; set; } = [];
    private List<(IMediaTrack Track, string FileName)> ExtractedTracks { get; set; } = [];
    private List<SubtitleFile> StayingSidecars { get; set; } = [];

    protected override void OnParametersSet()
    {
        var sidecars = Sidecars?.ToList() ?? [];
        var sidecarByIndex = sidecars.ToDictionary(s => s.Index);
        ExtractedTracks = [];
        if (PreviewTracks == null || PreviewTracks.Count == 0)
        {
            KeptTracks = Tracks.Select(t => new TrackWithPreview(t, null, null)).ToList();
            RemovedTracks = [];
            StayingSidecars = sidecars;
            return;
        }

        var extracted = (Plan?.ExtractedSubtitles ?? []).ToDictionary(e => e.Index, e => e.FileName);
        ExtractedTracks = Tracks.Where(t => extracted.ContainsKey(t.Index)).Select(t => (t, extracted[t.Index])).ToList();
        StayingSidecars = sidecars.Where(s => PreviewTracks.All(p => p.Index != s.Index)).ToList();

        var previewByNumber = PreviewTracks.ToDictionary(p => p.Index);
        var originalPositions = Tracks.Select((t, i) => (TrackNumber: t.Index, Index: i))
            .ToDictionary(x => x.TrackNumber, x => x.Index);

        KeptTracks = [];
        for (var i = 0; i < PreviewTracks.Count; i++)
        {
            var preview = PreviewTracks[i];
            var original = Tracks.FirstOrDefault(t => t.Index == preview.Index);
            if (original == null)
            {
                if (sidecarByIndex.TryGetValue(preview.Index, out var muxedIn))
                {
                    KeptTracks.Add(new TrackWithPreview(muxedIn, preview, null, muxedIn));
                }

                continue;
            }

            int? movedFrom = null;
            if (originalPositions.TryGetValue(preview.Index, out var origIdx) && origIdx != i)
            {
                movedFrom = origIdx + 1;
            }

            KeptTracks.Add(new TrackWithPreview(original, preview, movedFrom));
        }

        RemovedTracks = Tracks.Where(t => !previewByNumber.ContainsKey(t.Index) && !extracted.ContainsKey(t.Index)).ToList();
    }

}
